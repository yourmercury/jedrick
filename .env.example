###############################################################################
# Jedrick Insurance Brokers — environment variables
#
# Copy this file to `.env.local` and fill in the values you need:
#
#     cp .env.example .env.local
#
# `.env.local` is gitignored and must never be committed — it holds live keys.
# After editing it, restart the dev server: env vars are read at boot.
###############################################################################


# =============================================================================
# 1. SITE
# =============================================================================

# The public URL, used for canonical links, sitemap and Open Graph tags.
# No trailing slash. In development leave it as localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# =============================================================================
# 2. WHERE LEADS GO                                        ← the important part
# =============================================================================
#
# Two independent channels. Configure EITHER, or BOTH (both is recommended —
# email so a human sees it now, webhook so nothing is lost if an inbox is
# missed). If a channel is configured it must succeed, otherwise the visitor is
# told the submission failed rather than being shown a false confirmation.
#
# If NEITHER is set:
#   • in development — leads print to the terminal, so you can test the flows
#   • in production  — submissions are REFUSED, so no lead is silently dropped
#
# -----------------------------------------------------------------------------
# 2a. EMAIL (via Resend — https://resend.com, free tier covers ~3,000/month)
# -----------------------------------------------------------------------------
#
# Setup:
#   1. Create a Resend account and verify the jedrick domain (Domains → Add)
#   2. Create an API key (API Keys → Create), it starts with "re_"
#   3. Fill in all three values below — email is skipped unless all three are set
#
# Domain verification is what stops the notifications going to spam. Until the
# domain is verified you can send only to the address that owns the account.

RESEND_API_KEY=
# Who receives new leads. Comma-separate for several recipients.
LEAD_TO_EMAIL=jedrick360comms@gmail.com
# Who they appear to come from. MUST be on a domain verified in Resend —
# a gmail.com address will be rejected. e.g. website@jedrick.ng
LEAD_FROM_EMAIL=

# -----------------------------------------------------------------------------
# 2b. WEBHOOK (CRM, Zapier, Make, Google Sheets, or your own endpoint)
# -----------------------------------------------------------------------------
#
# The full lead is POSTed as JSON. Deliberately generic so any tool can consume
# it. Uploaded documents are NOT included in the webhook body — only their
# filenames — because most targets reject large payloads. The email channel
# carries the actual files.

LEAD_WEBHOOK_URL=
# Optional shared secret, sent as the X-Jedrick-Signature header so your
# endpoint can verify the request really came from this site.
LEAD_WEBHOOK_SECRET=


# =============================================================================
# 3. POLICY DOCUMENT UPLOADS
# =============================================================================
#
# Uploaded policies are emailed straight to the broker and are NOT written to
# disk or to any third-party store — the fewer copies of a client's policy
# document that exist, the better.
#
# This means the size limit is an email attachment limit. Raise it only if your
# mail provider accepts more. Resend's ceiling is 40MB per message.

# Maximum total size of all files in one submission, in megabytes.
POLICY_UPLOAD_MAX_MB=10
# Maximum number of files in one submission.
POLICY_UPLOAD_MAX_FILES=5


# =============================================================================
# 4. ANALYTICS (optional — Phase 4, safe to leave blank for now)
# =============================================================================

# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
